{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Medilink HMIS Desktop",
  "version": "1.0.0",
  "identifier": "com.almalick.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Medilink HMIS",
        "devtools": false,
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "homepage": "https://github.com/smart-thinker46/MedilinkD",
    "shortDescription": "Secure hospital information management desktop application.",
    "longDescription": "Medilink HMIS Desktop provides secure, role-aware hospital information management workflows for clinical and administrative teams.",
    "category": "Medical",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "headerImage": "installer/medilink-header.bmp",
        "sidebarImage": "installer/medilink-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "both",
        "languages": ["English"],
        "compression": "lzma",
        "startMenuFolder": "Medilink HMIS",
        "installerHooks": "installer/medilink-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/smart-thinker46/MedilinkD/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxNTE3Rjk0MDRCQkE3MUUKUldRZXA3c0VsSDlSWVlGWXJ4VkQxWDBrR0Z4SHJnNHpYZ3hNOXdWTVdIMG1mUFNxZTZFeWdQUkMK"
    }
  }
}
